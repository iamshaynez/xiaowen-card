/* ============ 预览 ============ */
.preview {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--paper);
  padding: 24rpx 32rpx 8rpx;
}
.preview-frame {
  background: #fff;
  border: 1rpx solid var(--hair);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  justify-content: center;
}
.card-canvas {
  width: 100%;
  border-radius: 8rpx;
  box-shadow: 0 16rpx 40rpx -18rpx rgba(20, 18, 16, 0.35);
}
.preview-note {
  text-align: center;
  margin-top: 16rpx;
  font-size: 20rpx;
  letter-spacing: 0.2em;
  color: var(--faint);
}

/* ============ 面板 ============ */
.panel {
  padding: 32rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}
.field {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.label {
  font-size: 24rpx;
  letter-spacing: 0.15em;
  color: var(--sub);
}
.size-out {
  color: var(--red);
  font-weight: 600;
}

.textarea,
.input {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--hair);
  border-radius: 8rpx;
  background: #fff;
  color: var(--ink);
  font-size: 28rpx;
  box-sizing: border-box;
}
.textarea {
  min-height: 180rpx;
  line-height: 1.8;
}
.sign-textarea {
  min-height: 110rpx;
}

/* 分段开关 */
.seg {
  display: flex;
  border: 1rpx solid var(--hair);
  border-radius: 8rpx;
  overflow: hidden;
}
.seg-btn {
  flex: 1;
  padding: 18rpx 0;
  background: #fff;
  font-size: 26rpx;
  letter-spacing: 0.15em;
  color: var(--sub);
  text-align: center;
}
.seg-btn.active {
  background: var(--ink);
  color: var(--cream);
}

/* 风格选择 */
.style-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.style-chip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  background: #fff;
  border: 1rpx solid var(--hair);
  border-radius: 8rpx;
  font-size: 26rpx;
  letter-spacing: 0.1em;
  color: var(--sub);
}
.style-chip.active {
  border-color: var(--ink);
  color: var(--ink);
  box-shadow: inset 0 0 0 1rpx var(--ink);
}
.sw {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--hair);
  flex: none;
  box-sizing: border-box;
}
.sw-paper {
  background: var(--paper);
}
.sw-ink {
  background: var(--ink);
}
.sw-cinnabar {
  background: linear-gradient(90deg, var(--red) 8rpx, var(--paper) 8rpx);
}
.sw-vertical {
  background: var(--ink);
  position: relative;
}
.sw-vertical::after {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 8rpx;
  bottom: 8rpx;
  width: 3rpx;
  background: var(--cream);
  box-shadow: 9rpx 0 0 var(--cream), 18rpx 0 0 var(--cream);
}
.sw-moon {
  background: #E4ECEC;
}
.sw-indigo {
  background: #232D36;
}
.sw-tea {
  background: #EFE9DD;
}
.sw-bamboo {
  background: #E3E8DE;
}

/* Logo */
.logo-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.logo-btn {
  padding: 16rpx 32rpx;
  border: 1rpx dashed var(--faint);
  border-radius: 8rpx;
  font-size: 24rpx;
  letter-spacing: 0.15em;
  color: var(--sub);
}
.logo-btn:active {
  border-color: var(--ink);
  color: var(--ink);
}
.logo-clear {
  color: var(--red);
  font-size: 24rpx;
  letter-spacing: 0.1em;
}
.logo-name {
  font-size: 22rpx;
  color: var(--faint);
}

/* ============ 底部操作栏 ============ */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(241, 241, 239, 0.94);
  border-top: 1rpx solid var(--hair);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
}
.save-btn {
  width: 100%;
}

/* 为固定底栏留出空间 */
.panel {
  padding-bottom: 200rpx;
}

/* ============ 导出画布（离屏隐藏） ============ */
.export-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 540px;
  height: 540px;
}
